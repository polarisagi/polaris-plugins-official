{
  "manifest_version": 3,
  "name": "Polaris Browser Bridge",
  "version": "1.2.1",
  "description": "让 Polaris 在独立窗口中使用你已登录的浏览器会话（仅限 Polaris 自己打开的标签）。",
  "permissions": [
    "debugger",
    "tabs",
    "storage",
    "alarms",
    "nativeMessaging"
  ],
  "background": {
    "service_worker": "sw.js",
    "type": "module"
  },
  "options_page": "options.html",
  "action": {
    "default_title": "Polaris Browser Bridge",
    "default_popup": "options.html?popup=1"
  },
  "key": ""
}
